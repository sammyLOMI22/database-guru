# Database Guru - Docker Environment Variables
# Copy to .env and customize before running docker compose
#
# Variables marked REQUIRED will cause docker compose to fail if not set.

# ============================================================
# REQUIRED — set these before first run
# ============================================================

# Generate with: openssl rand -hex 32
SECRET_KEY=

# ============================================================
# Default mode: docker compose up
# SQLite database + BYO LLM (connects to host machine's Ollama)
# ============================================================

# Ollama on host machine (default - works on Mac/Windows/Linux)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# ============================================================
# Ollama profile: docker compose --profile ollama up
# Bundled Ollama container (override URL to point to container)
# ============================================================

# OLLAMA_BASE_URL=http://ollama:11434

# ============================================================
# Full profile: docker compose --profile full up
# PostgreSQL + Redis — REQUIRED when using this profile
# ============================================================

# POSTGRES_USER=dbguru
# POSTGRES_PASSWORD=<generate a strong password>
# POSTGRES_DB=database_guru
#
# Least-privilege app user (optional but recommended for production).
# If set, init-db.sh creates an 'app_runtime' user with DML-only access.
# Use this user in DATABASE_URL instead of the owner for runtime operations.
# APP_DB_PASSWORD=<generate a strong password>
# DATABASE_URL=postgresql+asyncpg://app_runtime:<app_db_password>@postgres:5432/database_guru
#
# If you skip APP_DB_PASSWORD, the app connects as POSTGRES_USER (full privileges):
# DATABASE_URL=postgresql+asyncpg://dbguru:<password>@postgres:5432/database_guru

# REDIS_PASSWORD=<generate a strong password>
# REDIS_URL=redis://:<redis_password>@redis:6379

# ============================================================
# Graph profile (Phase 25 — Neo4j): docker compose --profile graph up
#
# NEO4J_AUTH defaults to "neo4j/password" in docker-compose.yml — that is a
# well-known credential and MUST be overridden for any environment beyond a
# laptop development DB. Format is "<user>/<password>".
#
# NEO4J_AUTH=neo4j/<generate a strong password>
#
# The Database Guru backend connects via the host:port mapped by Compose
# (127.0.0.1:7687). Operators who set GRAPH_MODE_ENABLED=False kill-switch
# Graph Mode entirely — create/test endpoints return HTTP 400 for neo4j.
# GRAPH_MODE_ENABLED=True

# ============================================================
# Observability profile: docker compose --profile observability up
#
# Easiest path: use the override file, which sets these for you:
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml \
#       --profile observability up -d
#
# If you don't use the override, uncomment the block below so the backend
# actually exposes /metrics, exports traces, and surfaces deep-links in the
# Admin tab. All flags default to off elsewhere — this is opt-in.
# ============================================================

# LOG_FORMAT=json
# METRICS_ENABLED=true
# METRICS_EXPOSE_ENDPOINT=true
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_SERVICE_NAME=database-guru
# OTEL_TRACES_SAMPLER_RATIO=0.1
# JAEGER_UI_URL=http://localhost:16686
# GRAFANA_URL=http://localhost:3001
# METRICS_PUBLIC_URL=http://localhost:9090
# ADMIN_UI_ENABLED=true
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=<set a strong password before any non-localhost deploy>

# ============================================================
# Auth hardening (see docs/planning/PASSWORD_AUTH_HARDENING_PLAN.md)
# Every flag defaults to off so an upgrade is behavior-preserving.
# Flip them once the matching phase ships and you have a rollout plan.
# ============================================================

# Phase A — token versioning (rejects stale JWTs after a password change/reset)
# AUTH_TOKEN_VERSIONING_ENABLED=true
# AUTH_INVALIDATE_TOKENS_ON_DEACTIVATE=true
# AUTH_INVALIDATE_TOKENS_ON_LOGOUT=false   # true = logout kicks every device

# Phase B — rate limit + login lockout
# AUTH_RATE_LIMIT_CHANGE_PASSWORD=true
# AUTH_CHANGE_PASSWORD_PER_USER_PER_MINUTE=5
# AUTH_RATE_LIMIT_LOGIN_LOCKOUT_ENABLED=true
# AUTH_LOGIN_LOCKOUT_THRESHOLD=5
# AUTH_LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Phase C — one-shot password reset tokens
# AUTH_PASSWORD_RESET_MODE=reset_token     # temp_password | reset_token | both
# AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# AUTH_PASSWORD_RESET_BASE_URL=http://localhost:3000

# Phase D — optional hardening
# AUTH_PASSWORD_HISTORY_DEPTH=5            # 0 = disabled
# AUTH_REQUIRE_ADMIN_QUORUM=true
