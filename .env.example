# Database Guru - Configuration Template
# Copy this file to .env and update with your local configuration

# Application
APP_NAME=Database Guru
VERSION=2.0.0
DEBUG=True

# Database - Using SQLite for local development (no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./database_guru.db

# Redis - Optional (comment out if Redis not running locally)
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Ollama - Using your local installation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_ALLOW_MODEL_SELECTION=True

# Security
SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890

# Query Limits
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# Query Compilation (Phase 4.2 - PRODUCTION-READY - Dec 7, 2025)
ENABLE_QUERY_COMPILATION=True
COMPILATION_MAX_STATEMENTS=100
COMPILATION_STATEMENT_TTL=1800
COMPILATION_MIN_EXECUTIONS=2
PLAN_CACHE_TTL_LOOKUP=86400
PLAN_CACHE_TTL_AGGREGATION=3600
PLAN_CACHE_TTL_JOIN=21600
